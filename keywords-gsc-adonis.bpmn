<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_KeywordsGSC" targetNamespace="https://keywords-gsc.local/bpmn">
  <bpmn:process id="Process_KeywordsGSC" name="Research and manage keywords" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Automatizacion" name="Automation">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Autocomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecalcularEstados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarWeb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PasaBanco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgregarBanco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MantenerSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarResumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="SEO analyst">
        <bpmn:flowNodeRef>Task_RevisarPriorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluarVolumenCompetencia</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Inicio" name="Start / scheduled or on-demand run">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GSC" name="Fetch Search Console metrics (monthly time trigger)">
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Autocomplete" name="Find new questions with Google Autocomplete (monthly time trigger)">
      <bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ActualizarSeguimiento" name="Update keyword tracking and suggest actions">
      <bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RevisarPriorizar" name="Review and prioritize questions">
      <bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluarVolumenCompetencia" name="Manually record search volume and assess competition">
      <bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecalcularEstados" name="Recalculate statuses and send a summary">
      <bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerificarWeb" name="Check keywords on published pages">
      <bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PasaBanco" name="Is the question eligible for the content bank?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_Si</bpmn:outgoing><bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AgregarBanco" name="Add prioritized question to the content bank">
      <bpmn:incoming>Flow_Si</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MantenerSeguimiento" name="Keep item in tracking">
      <bpmn:incoming>Flow_No</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnviarResumen" name="Email the summary">
      <bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Fin" name="End">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Inicio" targetRef="Task_GSC"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_GSC" targetRef="Task_Autocomplete"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Autocomplete" targetRef="Task_ActualizarSeguimiento"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ActualizarSeguimiento" targetRef="Task_RevisarPriorizar"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RevisarPriorizar" targetRef="Task_EvaluarVolumenCompetencia"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_EvaluarVolumenCompetencia" targetRef="Task_RecalcularEstados"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RecalcularEstados" targetRef="Task_VerificarWeb"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_VerificarWeb" targetRef="Gateway_PasaBanco"/>
    <bpmn:sequenceFlow id="Flow_Si" name="Yes" sourceRef="Gateway_PasaBanco" targetRef="Task_AgregarBanco"/>
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_PasaBanco" targetRef="Task_MantenerSeguimiento"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AgregarBanco" targetRef="Task_EnviarResumen"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_MantenerSeguimiento" targetRef="Task_EnviarResumen"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_EnviarResumen" targetRef="EndEvent_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_KeywordsGSC">
    <bpmndi:BPMNPlane id="BPMNPlane_KeywordsGSC" bpmnElement="Process_KeywordsGSC">
      <bpmndi:BPMNShape id="Shape_Lane_Automatizacion" bpmnElement="Lane_Automatizacion" isHorizontal="true"><dc:Bounds x="100" y="80" width="2800" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Analista" bpmnElement="Lane_Analista" isHorizontal="true"><dc:Bounds x="100" y="250" width="2800" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Inicio"><dc:Bounds x="130" y="145" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105" y="184" width="100" height="44"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GSC" bpmnElement="Task_GSC"><dc:Bounds x="220" y="125" width="150" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Autocomplete" bpmnElement="Task_Autocomplete"><dc:Bounds x="400" y="125" width="155" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Actualizar" bpmnElement="Task_ActualizarSeguimiento"><dc:Bounds x="585" y="125" width="160" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Revisar" bpmnElement="Task_RevisarPriorizar"><dc:Bounds x="775" y="295" width="150" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Evaluar" bpmnElement="Task_EvaluarVolumenCompetencia"><dc:Bounds x="960" y="295" width="170" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Recalcular" bpmnElement="Task_RecalcularEstados"><dc:Bounds x="1165" y="125" width="160" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Verificar" bpmnElement="Task_VerificarWeb"><dc:Bounds x="1360" y="125" width="160" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_PasaBanco" isMarkerVisible="true"><dc:Bounds x="1560" y="138" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1525" y="95" width="130" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Banco" bpmnElement="Task_AgregarBanco"><dc:Bounds x="1690" y="95" width="175" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Seguimiento" bpmnElement="Task_MantenerSeguimiento"><dc:Bounds x="1690" y="185" width="175" height="55"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Resumen" bpmnElement="Task_EnviarResumen"><dc:Bounds x="1910" y="135" width="155" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_Fin"><dc:Bounds x="2110" y="155" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="166" y="163"/><di:waypoint x="220" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="370" y="163"/><di:waypoint x="400" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="555" y="163"/><di:waypoint x="585" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="745" y="163"/><di:waypoint x="755" y="163"/><di:waypoint x="755" y="333"/><di:waypoint x="775" y="333"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5"><di:waypoint x="925" y="333"/><di:waypoint x="960" y="333"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="1130" y="333"/><di:waypoint x="1145" y="333"/><di:waypoint x="1145" y="163"/><di:waypoint x="1165" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7"><di:waypoint x="1325" y="163"/><di:waypoint x="1360" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8"><di:waypoint x="1520" y="163"/><di:waypoint x="1560" y="163"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Si" bpmnElement="Flow_Si"><di:waypoint x="1610" y="163"/><di:waypoint x="1650" y="163"/><di:waypoint x="1650" y="133"/><di:waypoint x="1690" y="133"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_No" bpmnElement="Flow_No"><di:waypoint x="1585" y="188"/><di:waypoint x="1585" y="212"/><di:waypoint x="1690" y="212"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9"><di:waypoint x="1865" y="133"/><di:waypoint x="1885" y="133"/><di:waypoint x="1885" y="173"/><di:waypoint x="1910" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1865" y="212"/><di:waypoint x="1885" y="212"/><di:waypoint x="1885" y="173"/><di:waypoint x="1910" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11"><di:waypoint x="2065" y="173"/><di:waypoint x="2110" y="173"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
